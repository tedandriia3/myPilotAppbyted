# Firebase Firestore Indexes Configuration
# Placez ce fichier dans votre projet Firebase Console

# Collection: weekly_tips
# Index composite pour les requêtes de recherche
{
  "indexes": [
    {
      "collectionGroup": "weekly_tips",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "isActive",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "weekOfYear",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "collectionGroup": "weekly_tips",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "category",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "isActive",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "weekOfYear",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}

